

# --- LLMs ---
ANTHROPIC_API_KEY=          # base LLM: claude-haiku-5-5 (required)
OPENAI_API_KEY=             # embeddings + gpt-6-luna fallback (required)
GROQ_API_KEY=               # open-source switchover: openai/gpt-oss-120b (optional for now)

# --- Database (Neon) ---
# Neon Console > project > Connect > Connection pooling ON  -> pooled string (-pooler in host)
DATABASE_URL=
# Same modal, Connection pooling OFF -> direct string (used for migrations)
DATABASE_URL_DIRECT=

# --- Tracing (Langfuse; or set LANGSMITH_API_KEY instead) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- Paths ---
DATASET_DIR=data-original
